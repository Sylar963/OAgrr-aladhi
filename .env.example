PORT=3100
NODE_ENV=production
LOG_LEVEL=info

# Trade history. Ingest writes SQLite and performs periodic Postgres uploads;
# the API server reads the same SQLite file and merges it with Postgres history.
DATABASE_URL=
TRADE_SQLITE_PATH=/data/oggregator-cache/ingest-trades.sqlite
TRADE_CACHE_PATH=/data/oggregator-cache/ingest-trades.ndjson
TRADE_DB_FLUSH_INTERVAL_MS=604800000

SHORT_STRADDLE_SNAPSHOTS_ENABLED=false
SHORT_STRADDLE_SNAPSHOT_CACHE_PATH=.cache/short-straddle-snapshots.ndjson
SHORT_STRADDLE_QUOTE_MAX_AGE_MS=60000

# Venue credentials (optional — when absent the affected venue degrades
# gracefully: chain/WS no-ops or chart panels fall back to the live
# MarkHistoryBuffer instead of REST history).
#
# Coincall: chain WS, live-trade tape, and REST kline history all sign.
COINCALL_API_KEY=
COINCALL_API_SECRET=
#
# Gate.io: only /options/mark_price_candlesticks (signed mark-history) is
# auth-gated today; chain/WS/trade-tape stay public.
GATEIO_API_KEY=
GATEIO_API_SECRET=

# Private portfolio adapters (Derive, Thalex) connect only after a Clerk account
# is authenticated. Credentials are encrypted with AES-256-GCM before Postgres
# storage and are never returned by the API. Off by default.
PRIVATE_VENUE_ADAPTERS_ENABLED=
# Required when private adapters are enabled. Generate with: openssl rand -base64 32
# Keep this stable across deploys; losing it makes stored credentials unreadable.
VENUE_CREDENTIALS_ENCRYPTION_KEY=
# Id written into new ciphertexts (v2.<id>....). Change it together with the key to rotate.
VENUE_CREDENTIALS_KEY_ID=k1
# Retired keys kept for reading old rows: id:key,id:key. Run
# `pnpm --filter @oggregator/server credentials:rewrap` to move rows to the current key.
VENUE_CREDENTIALS_PREVIOUS_KEYS=
#
# Derive connects through the user's wallet (Reown AppKit): the wallet registers
# a read-only session key that the server generates and holds. Lifetime in days
# (default 90) and an optional comma-separated list of the backend's egress IPs;
# when set, Derive rejects logins with that key from any other IP.
DERIVE_SESSION_KEY_TTL_DAYS=
DERIVE_SESSION_KEY_IP_WHITELIST=
#
# Paradex connects through the wallet (EVM accounts) or a pasted read-only key.
# The browser asks Paradex for a read-only key with this lifetime in days (default
# 90, max 365) and optional comma-separated CIDR allowlist (e.g. 203.0.113.7/32).
PARADEX_READONLY_TOKEN_TTL_DAYS=
PARADEX_READONLY_TOKEN_ALLOWED_CIDRS=
#
# Frontend: Reown project ID from https://dashboard.reown.com. Without it the
# Connect wallet button reports that wallet connect is not configured.
VITE_REOWN_PROJECT_ID=

# Optional: path to a JSON file the server reads to surface a site-wide status
# announcement on GET /api/health. Edit the file to flip a flag (no restart).
# Shape: { "id", "severity": info|notice|degraded|outage, "blocking": bool,
#          "title", "message"?, "startsAt"?: epochMs, "endsAt"?: epochMs }
# severity sets tone/color; "blocking": true is what renders a full-screen
# takeover (an outage with blocking:false is still just a sticky banner).
# Empty file / null / invalid → no announcement.
STATUS_FILE=

# Clerk (real identity). The paper/portfolio routes + WS always require a verified
# Clerk JWT. For local dev without Postgres, set AUTH_DEV_BYPASS=1 to skip auth and
# resolve to the default paper account. It is ignored when NODE_ENV=production and
# never applies to /api/live routes.
AUTH_DEV_BYPASS=
#
# Server-side (Scaleway): verify tokens networklessly against Clerk's JWKS.
CLERK_SECRET_KEY=
CLERK_JWKS_URL=https://<your-subdomain>.clerk.accounts.dev/.well-known/jwks.json
# Defaults to the CLERK_JWKS_URL origin. Set explicitly for custom Clerk domains.
CLERK_JWT_ISSUER=
# Optional Clerk JWT audience; when set, tokens must contain this audience.
CLERK_JWT_AUDIENCE=
#
# Frontend (Vite SPA): public publishable key for the Clerk React SDK.
VITE_CLERK_PUBLISHABLE_KEY=

# Portfolio page Ask Hermes beta. Keep disabled until migrations 0024/0025
# are applied and the private Hermes profile with read-only Oggregator MCP tools is reachable.
PORTFOLIO_ASSISTANT_ENABLED=false
HERMES_PORTFOLIO_API_URL=http://127.0.0.1:8642/p/portfolio-chat/v1
# Strong bearer token for Oggregator -> Hermes only. Never expose through Vite.
HERMES_PORTFOLIO_API_KEY=
HERMES_PORTFOLIO_MODEL=portfolio-chat
HERMES_PORTFOLIO_REQUEST_TIMEOUT_MS=90000
# Oggregator read-only MCP listener. Use the same token in the Hermes profile.
# At least 32 random characters; separate from HERMES_PORTFOLIO_API_KEY.
OGG_ASSISTANT_MCP_TOKEN=
OGG_ASSISTANT_MCP_PORT=3191
OPTIONS_LIBRARY_PATH=docs/options-library.sqlite
PORTFOLIO_ASSISTANT_DAILY_QUESTION_LIMIT=20
PORTFOLIO_ASSISTANT_MAX_CONCURRENT_REQUESTS=4
PORTFOLIO_ASSISTANT_RETENTION_DAYS=30
# HMAC secret used to digest beta invite codes before lookup/storage.
PORTFOLIO_ASSISTANT_INVITE_HASH_SECRET=

# Funded program. Off by default — the funded routes and the 08:00 UTC daily
# scheduler are only activated when this is explicitly set to 1 or true.
FUNDED_PROGRAM_ENABLED=
#
# Admin-settle endpoint (POST /api/funded/admin/settle). Checked against the
# x-funded-admin-token request header; returns 503 when unset or empty.
# Must be set to a strong secret on any deployment that exposes the endpoint.
FUNDED_ADMIN_TOKEN=

# Landing site (apps/landing) — a separate Next.js deploy. NEXT_PUBLIC_APP_URL is
# the launch-CTA target (the live SPA). LANDING_API_BASE_URL is the core API the
# landing fetches market data from (ISR) and forwards leads to (server-to-server).
# Both optional locally: unset → demo data + the local JSONL lead sink.
NEXT_PUBLIC_APP_URL=https://app.oggregator.xyz
LANDING_API_BASE_URL=https://api.oggregator.xyz
LANDING_LEADS_FILE=

# Web SPA (packages/web) — production TradFi calls reuse the existing API domain.
VITE_TRADFI_API_BASE=https://api.oggregator.xyz/tradfi-api
# Aggr live charts (separate app on this host, see aggr/deploy). Unset → CHARTS link hidden.
VITE_AGGR_URL=https://charts.oggregator.xyz

# --- TradFi (TastyTrade) backend — @oggregator/tradfi, separate process on :3200 ---
# Real secrets live ONLY in the gitignored repo-root .env on the host, never in git.
# Personal OAuth2 grant from my.tastytrade.com → app → Manage → Create Grant (read scope).
TASTYTRADE_CLIENT_ID=
TASTYTRADE_CLIENT_SECRET=
TASTYTRADE_REFRESH_TOKEN=
TRADFI_PORT=3200
TRADFI_UNDERLYINGS=SPX,NDX,SPY,QQQ,AAPL,NVDA,TSLA
# IV/skew history: a separate Neon database (not DATABASE_URL), flushed once a day. Unset = local cache only.
TRADFI_DATABASE_URL=
TRADFI_IV_HISTORY_UNDERLYINGS=SPX,NDX,SPY,QQQ,AAPL,NVDA,TSLA
# Optional overrides:
# TASTYTRADE_BASE_URL=https://api.tastyworks.com
# TASTYTRADE_USER_AGENT=oggregator-tradfi/0.1

# Live trading (Thalex). Off unless "true". The API never holds trading keys; it forwards
# signed commands to the execution daemon (packages/execution, deploy/README.md).
LIVE_TRADING_ENABLED=
# Step-up window: a second factor verified within this many minutes (1-10, default 10).
LIVE_STEPUP_MAX_MINUTES=
EXECUTION_SOCKET_PATH=/run/ogg-exec/exec.sock
# Shared with the daemon (32 bytes, hex or base64): openssl rand -hex 32
EXECUTION_SOCKET_HMAC_KEY=
