{
  "name": "@oggregator/execution",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "keys:import": "tsx src/cli/keys-import.ts",
    "totp:enroll": "tsx src/cli/totp-enroll.ts",
    "lint": "biome lint .",
    "typecheck": "pnpm --filter @oggregator/protocol build && tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@oggregator/protocol": "workspace:*",
    "pino": "10.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
