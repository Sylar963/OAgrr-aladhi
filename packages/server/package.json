{
  "name": "@oggregator/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "lint": "biome lint .",
    "typecheck": "pnpm --filter @oggregator/core build && pnpm --filter @oggregator/db build && tsc --noEmit",
    "test": "vitest",
    "library:build": "tsx src/scripts/build-options-library.ts",
    "test:run": "pnpm --filter @oggregator/core build && pnpm --filter @oggregator/db build && vitest run"
  },
  "dependencies": {
    "@fastify/compress": "8.3.1",
    "@fastify/cors": "10.1.0",
    "@fastify/helmet": "13.0.2",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/static": "10.1.4",
    "@fastify/websocket": "11.2.0",
    "@oggregator/core": "workspace:*",
    "@oggregator/db": "workspace:*",
    "@oggregator/funded": "workspace:*",
    "@oggregator/protocol": "workspace:",
    "@oggregator/trading": "workspace:",
    "dotenv": "16.6.1",
    "fastify": "5.12.5",
    "jose": "5.9.6",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "@types/ws": "8.18.1",
    "pdfjs-dist": "^6.3.289",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "ws": "8.21.3"
  }
}
